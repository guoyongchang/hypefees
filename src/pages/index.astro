---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import BuilderTable from '../components/BuilderTable.tsx';
import AddressLookup from '../components/AddressLookup.tsx';
import FeeSimulator from '../components/FeeSimulator.tsx';
import SwitchBuilder from '../components/SwitchBuilder.tsx';
---

<Layout>
  <ThemeToggle client:load slot="header-actions" />

  <!-- Hero: Address Lookup is the primary action -->
  <section class="py-14 md:py-20">
    <h1 class="text-3xl md:text-[2.75rem] font-bold tracking-tight leading-[1.15] max-w-2xl">
      How much are you overpaying on Hyperliquid?
    </h1>
    <p class="mt-3 text-[var(--color-text-secondary)] max-w-xl">
      Enter your address to see your fee breakdown instantly.
    </p>
    <div class="mt-8">
      <AddressLookup client:load />
    </div>
  </section>

  <!-- Switch Builder — right after hero -->
  <section class="pb-14">
    <SwitchBuilder client:load />
  </section>

  <!-- Builder Fee Comparison Table -->
  <section class="section-alt py-14">
    <h2 class="text-xl md:text-2xl font-bold mb-1">Builder Fee Comparison</h2>
    <p class="text-sm text-[var(--color-text-secondary)] mb-8">
      Sorted by fee rate. Total = Hyperliquid base fee + builder fee.
    </p>
    <BuilderTable client:load />
  </section>

  <!-- Fee Simulator -->
  <section class="py-14">
    <h2 class="text-xl md:text-2xl font-bold mb-1">Fee Simulator</h2>
    <p class="text-sm text-[var(--color-text-secondary)] mb-8">
      See how much you'd pay across builders at any volume.
    </p>
    <FeeSimulator client:load />
  </section>

  <!-- FAQ -->
  <section class="section-alt py-14">
    <h2 class="text-xl md:text-2xl font-bold mb-8">FAQ</h2>
    <div class="space-y-3 max-w-3xl">
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)] transition-colors">
          What is a builder fee?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          When you trade on Hyperliquid through a third-party wallet (Phantom, MetaMask, etc.),
          that wallet adds a builder fee on top of Hyperliquid's exchange fees. Rates range from 0% to 0.10%.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)] transition-colors">
          How do I switch to a cheaper builder?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Connect your wallet above and approve a new builder with a lower fee.
          It's a single on-chain signature — your funds, positions, and history are not affected.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)] transition-colors">
          Is switching safe?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Yes. You're approving a builder address with a fee cap — no funds are transferred.
          You can switch back or change builders at any time. Up to 10 builder approvals can be active.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)] transition-colors">
          Where does this data come from?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Builder data from HyperTracker (CoinMarketMan). Fee breakdowns from Hyperliquid's public API.
          Everything is verifiable on-chain.
        </div>
      </details>
    </div>
  </section>
</Layout>
