---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import HeroSection from '../components/HeroSection.tsx';
import BuilderTable from '../components/BuilderTable.tsx';
import FeeSimulator from '../components/FeeSimulator.tsx';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<Layout>
  <ThemeToggle client:load slot="header-actions" />

  <!-- Hero -->
  <section class="hero-section relative overflow-hidden -mx-4 px-4">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10">
      <HeroSection client:load />
    </div>
  </section>

  <!-- What Are Builder Fees — SEO explainer -->
  <section class="section-alt py-14">
    <div class="max-w-3xl reveal">
      <h2 class="text-xl md:text-2xl font-bold mb-4">What Are Hyperliquid Builder Fees?</h2>
      <div class="space-y-3 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        <p>
          Hyperliquid is a high-performance Layer 1 blockchain built for perpetual futures trading.
          When you access Hyperliquid through a third-party wallet or frontend — such as Phantom, MetaMask,
          Rabby, or any other interface — that wallet may attach a <strong class="text-[var(--color-text)]">builder fee</strong>
          to every trade you execute.
        </p>
        <p>
          Builder fees are charged on top of Hyperliquid's base exchange fees (0.035% taker / 0.01% maker for VIP 0).
          They range from <strong class="text-[var(--color-text)]">0% to 0.10%</strong> depending on which wallet you use.
          At 0.10%, a trader doing $1M in monthly volume pays an extra <strong class="text-[var(--color-text)]">$1,000</strong>
          that goes entirely to the wallet provider — not to Hyperliquid.
        </p>
        <p>
          Some wallets like OneKey charge 0% builder fees. That means the only fee you pay is Hyperliquid's
          base exchange fee. No markup, no hidden charges. HypeFees exists to make this information
          transparent and help traders choose the most cost-effective wallet.
        </p>
      </div>
    </div>
  </section>

  <!-- Builder Fee Comparison Table -->
  <section class="py-14">
    <div class="reveal">
      <h2 class="text-xl md:text-2xl font-bold mb-1">Hyperliquid Builder Fee Comparison</h2>
      <p class="text-sm text-[var(--color-text-secondary)] mb-8">
        Compare builder fees across 240+ wallets and frontends. Sorted by fee rate.
        Total = Hyperliquid base fee + builder fee.
      </p>
    </div>
    <div class="reveal" style="transition-delay: 100ms;">
      <BuilderTable client:load />
    </div>
  </section>

  <!-- Fee Simulator -->
  <section class="section-alt py-14">
    <div class="reveal">
      <h2 class="text-xl md:text-2xl font-bold mb-1">Hyperliquid Fee Calculator</h2>
      <p class="text-sm text-[var(--color-text-secondary)] mb-8">
        Calculate your total trading costs across different builders and volumes. Adjust the slider to see how
        builder fees compound as your trading volume grows.
      </p>
    </div>
    <div class="reveal" style="transition-delay: 100ms;">
      <FeeSimulator client:load />
    </div>
  </section>

  <!-- How Builder Fees Work — SEO -->
  <section class="py-14">
    <div class="max-w-3xl reveal">
      <h2 class="text-xl md:text-2xl font-bold mb-4">How Hyperliquid Builder Fees Work</h2>
      <div class="space-y-3 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        <p>
          Hyperliquid uses a system called <strong class="text-[var(--color-text)]">builder codes</strong>.
          When a wallet or trading frontend integrates with Hyperliquid, it registers as a "builder"
          and sets a fee rate. Every order placed through that frontend automatically includes the
          builder fee as an additional charge.
        </p>
        <p>
          The builder fee is specified per-order and is measured in tenths of basis points.
          For perpetual contracts, the maximum allowed builder fee is 0.10% (10 basis points).
          The fee applies to both buy and sell orders. Builders must maintain at least 100 USDC
          in their perps account to be eligible.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-text)] pt-3">Hyperliquid Base Exchange Fees (Without Builder Fees)</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-xs border border-[var(--color-border)] rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-[var(--color-bg-secondary)]">
                <th class="text-left px-3 py-2 font-medium">VIP Tier</th>
                <th class="text-left px-3 py-2 font-medium">14-Day Volume</th>
                <th class="text-left px-3 py-2 font-medium">Taker Fee</th>
                <th class="text-left px-3 py-2 font-medium">Maker Fee</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-border)]">
              <tr><td class="px-3 py-2">VIP 0</td><td class="px-3 py-2">&lt; $5M</td><td class="px-3 py-2">0.035%</td><td class="px-3 py-2">0.010%</td></tr>
              <tr><td class="px-3 py-2">VIP 1</td><td class="px-3 py-2">$5M–$25M</td><td class="px-3 py-2">0.030%</td><td class="px-3 py-2">0.008%</td></tr>
              <tr><td class="px-3 py-2">VIP 2</td><td class="px-3 py-2">$25M–$100M</td><td class="px-3 py-2">0.025%</td><td class="px-3 py-2">0.005%</td></tr>
              <tr><td class="px-3 py-2">VIP 3</td><td class="px-3 py-2">$100M–$500M</td><td class="px-3 py-2">0.020%</td><td class="px-3 py-2">0.002%</td></tr>
              <tr><td class="px-3 py-2">VIP 4</td><td class="px-3 py-2">$500M–$2B</td><td class="px-3 py-2">0.018%</td><td class="px-3 py-2">0.001%</td></tr>
              <tr><td class="px-3 py-2">VIP 5</td><td class="px-3 py-2">$2B–$7B</td><td class="px-3 py-2">0.015%</td><td class="px-3 py-2">0.0005%</td></tr>
              <tr><td class="px-3 py-2">VIP 6</td><td class="px-3 py-2">&gt; $7B</td><td class="px-3 py-2">0.014%</td><td class="px-3 py-2">0.000%</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          Builder fees are added on top of the base fees above. For example, if you are VIP 0 (0.035% taker)
          and your wallet charges a 0.05% builder fee, your effective taker fee is 0.085% per trade.
          With a 0% builder fee wallet, you pay only 0.035%.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-text)] pt-3">How to Change Your Builder</h3>
        <p>
          Switching builders is a simple, gasless process. You sign an EIP-712 typed message called
          <code class="text-xs bg-[var(--color-bg-elevated)] px-1.5 py-0.5 rounded">approveBuilderFee</code>
          with your wallet. This tells Hyperliquid which builder to route your trades through and the
          maximum fee rate you approve. No funds are transferred and no gas is required.
          You can have up to 10 active builder approvals and switch between them at any time.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-alt py-14">
    <div class="reveal">
      <h2 class="text-xl md:text-2xl font-bold mb-8">Frequently Asked Questions</h2>
    </div>
    <div class="space-y-3 max-w-3xl reveal" style="transition-delay: 80ms;">
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          What is a Hyperliquid builder fee?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          A builder fee is an additional trading fee charged by third-party wallets and trading interfaces when
          you execute trades on Hyperliquid. It is added on top of Hyperliquid's base exchange fees. Builder fees
          range from 0% to 0.10% and are set by each wallet provider independently. The fee goes to the wallet
          provider, not to Hyperliquid.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Which wallets charge the lowest builder fees on Hyperliquid?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Several wallets charge 0% builder fees, meaning you only pay Hyperliquid's base exchange fees.
          OneKey is the most widely used 0% builder fee wallet. You can see the complete comparison in the
          builder fee table above, sorted by fee rate from lowest to highest.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          How much do builder fees cost per year?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          It depends on your trading volume. A trader doing $1M per month in volume with a 0.05% builder
          fee (like Phantom) pays $500/month or $6,000/year in builder fees alone. With MetaMask at
          0.10%, that doubles to $12,000/year. Switching to a 0% builder eliminates this cost entirely.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          How do I switch to a lower-fee builder on Hyperliquid?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Connect your wallet on HypeFees and use the one-click switch feature. You sign an EIP-712
          message (no gas required) that approves a new builder with a lower fee rate. The switch takes
          effect immediately. Your existing positions, orders, and trading history are not affected.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Is it safe to switch Hyperliquid builders?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Yes. Switching builders only changes which wallet provider receives the builder fee portion of your
          trading costs. No funds are transferred, no tokens are approved, and no smart contract interactions
          occur. You can have up to 10 active builder approvals simultaneously.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          What is the difference between exchange fees and builder fees?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Hyperliquid exchange fees are the base trading fees charged by the protocol. These vary by VIP tier.
          Builder fees are additional fees charged by your wallet on top of exchange fees.
          Total cost = exchange fee + builder fee. HypeFees shows both.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Can I check how much I've paid in builder fees?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Yes. Enter your Ethereum address in the lookup at the top of this page. HypeFees fetches your
          complete trading history from Hyperliquid's public API and shows a breakdown of exchange fees
          vs. builder fees. All data is on-chain and verifiable.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Does Phantom charge a builder fee on Hyperliquid?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Yes. Phantom charges a 0.05% builder fee on Hyperliquid trades. On $1M in volume, that's $500
          in additional fees. Your effective taker rate with Phantom at VIP 0 is 0.085%.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Does MetaMask charge a builder fee on Hyperliquid?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Yes. MetaMask charges 0.10% — the maximum allowed builder fee. On $1M in trading volume,
          that's $1,000 in builder fees alone. Switching to a 0% builder eliminates this cost.
        </div>
      </details>
      <details class="group border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)]">
        <summary class="px-5 py-4 cursor-pointer font-medium hover:text-[var(--color-accent)]">
          Where does HypeFees get its data?
        </summary>
        <div class="px-5 pb-4 text-[var(--color-text-secondary)] text-sm leading-relaxed">
          Builder data from HyperTracker (CoinMarketMan). Fee breakdowns from Hyperliquid's public API.
          HypeFees is independent and open-source — not affiliated with Hyperliquid or any wallet.
        </div>
      </details>
    </div>
  </section>

  <ScrollReveal />
</Layout>

<style>
  .hero-grid {
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 100%);
  }
</style>
