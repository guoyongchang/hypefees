---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import LanguageSwitcher from '../components/LanguageSwitcher.tsx';
import TranslatedText from '../components/TranslatedText.tsx';
import HeroSection from '../components/HeroSection.tsx';
import BuilderTable from '../components/BuilderTable.tsx';
import FeeSimulator from '../components/FeeSimulator.tsx';
import SectionAbout from '../components/SectionAbout.tsx';
import SectionHowItWorks from '../components/SectionHowItWorks.tsx';
import SectionFAQ from '../components/SectionFAQ.tsx';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<Layout>
  <Fragment slot="header-actions">
    <LanguageSwitcher client:load />
    <ThemeToggle client:load />
  </Fragment>

  <!-- Hero — above the fold, needs immediate hydration -->
  <section aria-label="Fee lookup tool" class="hero-section relative overflow-hidden -mx-4 px-4">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10">
      <HeroSection client:load />
    </div>
  </section>

  <!-- What Are Builder Fees — text-only, hydrate when idle -->
  <section aria-label="What are builder fees" class="section-alt" style="padding-top: var(--space-section); padding-bottom: var(--space-section);">
    <div class="max-w-3xl reveal">
      <h2 class="mb-4"><TranslatedText client:idle k="section.whatAre" /></h2>
      <SectionAbout client:idle />
    </div>
  </section>

  <!-- Builder Fee Comparison — interactive, hydrate when visible -->
  <section aria-label="Builder fee comparison table" style="padding-top: var(--space-section); padding-bottom: var(--space-section);">
    <div class="reveal">
      <h2 class="mb-1"><TranslatedText client:idle k="section.comparison" /></h2>
      <p class="text-[var(--color-text-secondary)] mb-6" style="font-size: var(--text-sm);">
        <TranslatedText client:idle k="comparison.subtitle" />
      </p>
    </div>
    <div class="reveal" style="transition-delay: 100ms;">
      <BuilderTable client:visible />
    </div>
  </section>

  <!-- Fee Calculator — interactive, hydrate when visible -->
  <section aria-label="Fee savings calculator" class="section-alt" style="padding-top: var(--space-section); padding-bottom: var(--space-section);">
    <div class="reveal">
      <h2 class="mb-1"><TranslatedText client:idle k="section.calculator" /></h2>
      <p class="text-[var(--color-text-secondary)] mb-6" style="font-size: var(--text-sm);">
        <TranslatedText client:idle k="calculator.subtitle" />
      </p>
    </div>
    <div class="reveal" style="transition-delay: 100ms;">
      <FeeSimulator client:visible />
    </div>
  </section>

  <!-- How Builder Fees Work — text-only, hydrate when idle -->
  <section aria-label="How builder fees work" style="padding-top: var(--space-section); padding-bottom: var(--space-section);">
    <div class="max-w-3xl reveal">
      <h2 class="mb-4"><TranslatedText client:idle k="section.howItWorks" /></h2>
      <SectionHowItWorks client:idle />
    </div>
  </section>

  <!-- FAQ — text-only, hydrate when visible -->
  <section aria-label="Frequently asked questions" class="section-alt" style="padding-top: var(--space-section); padding-bottom: var(--space-section);">
    <div class="reveal">
      <h2 class="mb-6"><TranslatedText client:idle k="section.faq" /></h2>
    </div>
    <div class="space-y-2 max-w-3xl reveal" style="transition-delay: 80ms;">
      <SectionFAQ client:idle />
    </div>
  </section>

  <ScrollReveal />
</Layout>

<style>
  .hero-grid {
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 100%);
  }
</style>
