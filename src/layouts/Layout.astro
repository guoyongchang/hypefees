---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hypefees — Compare Hyperliquid Builder Fees',
  description = 'Compare builder fees across all Hyperliquid wallet providers. Find the lowest fees, check your spending, and switch to save money.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preload" href="/fonts/RoobertVF.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Theme initialization - prevent flash
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <!-- Skip to content link for keyboard users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--color-accent)] focus:text-white focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <header class="border-b border-[var(--color-border)] sticky top-0 z-50 bg-[var(--color-bg)]/95 backdrop-blur-sm">
      <nav aria-label="Main" class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="py-2 px-1 min-h-[44px] flex items-center gap-2">
          <img src="/logo.png" alt="" width="28" height="28" class="rounded-md" aria-hidden="true" />
          <span class="text-xl font-bold tracking-tight">Hype<span class="text-[var(--color-accent)]">fees</span></span>
        </a>
        <div class="flex items-center gap-3" id="header-actions">
          <slot name="header-actions" />
        </div>
      </nav>
    </header>

    <main id="main" class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto px-4 py-10 text-sm text-[var(--color-text-muted)]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <img src="/logo.png" alt="" width="24" height="24" class="rounded" loading="lazy" aria-hidden="true" />
              <span class="text-base font-bold text-[var(--color-text)]">Hype<span class="text-[var(--color-accent)]">fees</span></span>
            </div>
            <p class="text-sm leading-relaxed">
              Independent fee comparison tool for Hyperliquid traders. Not affiliated with Hyperliquid.
            </p>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3">Resources</div>
            <ul class="space-y-2">
              <li><a href="https://hyperliquid.gitbook.io/hyperliquid-docs/trading/fees" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Hyperliquid Fee Docs</a></li>
              <li><a href="https://hyperliquid.gitbook.io/hyperliquid-docs/trading/builder-codes" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Builder Codes Docs</a></li>
            </ul>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3">Project</div>
            <ul class="space-y-2">
              <li><a href="https://github.com/rayston92/hypefees" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-[var(--color-border)] mt-8 pt-6 text-xs text-[var(--color-text-muted)]">
          Data sourced from Hyperliquid public API and HyperTracker. All information is for reference only — verify on-chain before making decisions.
        </div>
      </div>
    </footer>
  </body>
</html>
