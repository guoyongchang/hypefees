---
import '../styles/global.css';
import FeeCounter from '../components/FeeCounter.tsx';
import TranslatedText from '../components/TranslatedText.tsx';
import MobileWalletBanner from '../components/MobileWalletBanner.tsx';

// Security headers
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = 'https://hypefees.com';

const {
  title = 'HypeFees — Compare Hyperliquid Builder Fees & Save on Trading Costs',
  description = 'Compare builder fees across Hyperliquid wallets. Check your hidden fees, find the cheapest wallet, and switch builders in one click to save thousands.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a Hyperliquid builder fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An extra fee your wallet quietly adds on top of Hyperliquid's exchange fees. Each wallet sets its own rate — anywhere from 0% to 0.10%. The money goes to the wallet provider, not the exchange."
      }
    },
    {
      "@type": "Question",
      "name": "Which wallets have the lowest fees?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "OneKey charges 0%. Several others also offer 0% builder fees. Check the comparison table on HypeFees to find the best option for you."
      }
    },
    {
      "@type": "Question",
      "name": "How much can builder fees cost per year?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At $1M/month volume: Phantom (0.05%) costs $6,000/year. MetaMask (0.10%) costs $12,000/year. A 0% builder costs $0."
      }
    },
    {
      "@type": "Question",
      "name": "How do I switch to a different builder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Connect your wallet and sign an EIP-712 message — that's it. No gas fees, no fund transfers, takes effect instantly. Your positions and history stay exactly the same."
      }
    },
    {
      "@type": "Question",
      "name": "Is switching safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Completely. You're just signing a message — no tokens approved, no smart contract calls, no funds moved. You can have up to 10 active builder approvals and switch back anytime."
      }
    },
    {
      "@type": "Question",
      "name": "Does Phantom charge a builder fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 0.05%. On $1M volume, that's $500 extra. Your effective VIP 0 taker rate becomes 0.085%."
      }
    },
    {
      "@type": "Question",
      "name": "Does MetaMask charge a builder fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 0.10%, the maximum allowed. On $1M volume, that's $1,000 extra."
      }
    },
    {
      "@type": "Question",
      "name": "Can I check my past builder fees?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Enter your address on HypeFees. It pulls your full trade history from Hyperliquid's public API and shows you exactly how much went to exchange fees vs. builder fees."
      }
    },
    {
      "@type": "Question",
      "name": "Where does this data come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Builder data from HyperTracker (CoinMarketMan). Fee breakdowns from Hyperliquid's public API. Everything is on-chain and verifiable. HypeFees is independent and open-source."
      }
    }
  ]
};

const webAppStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "HypeFees",
  "url": SITE_URL,
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "HypeFees",
    "url": SITE_URL
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Hyperliquid, builder fees, trading fees, wallet comparison, Phantom fees, MetaMask fees, OneKey, crypto trading, fee calculator, builder codes, DeFi fees" />
    <meta name="author" content="HypeFees" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preload" href="/fonts/RoobertVF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://api.hyperliquid.xyz" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/logo.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="HypeFees" />
    <meta property="og:locale" content="en_US" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hypefees" />
    <meta name="twitter:creator" content="@hypefees" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/logo.png`} />
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <title>{title}</title>
    <script is:inline>
      // Theme initialization - prevent flash
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Mixpanel Analytics (async, non-blocking) -->
    <script is:inline>
      (function(f,b){if(!b.__SV){var e,g,i,h;window.mixpanel=b;b._i=[];b.init=function(e,f,c){function g(a,d){var b=d.split(".");2==b.length&&(a=a[b[0]],d=b[1]);a[d]=function(){a.push([d].concat(Array.prototype.slice.call(arguments,0)))}}var a=b;"undefined"!==typeof c?a=b[c]=[]:c="mixpanel";a.people=a.people||[];a.toString=function(a){var d="mixpanel";"mixpanel"!==c&&(d+="."+c);a||(d+=" (stub)");return d};a.people.toString=function(){return a.toString(1)+".people (stub)"};i="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<i.length;h++)g(a,i[h]);var j="set set_once union unset remove delete".split(" ");a.get_group=function(){function b(c){d[c]=function(){call2_args=arguments;call2=[c].concat(Array.prototype.slice.call(call2_args,0));a.push([e,call2])}}for(var d={},e=["get_group"].concat(Array.prototype.slice.call(arguments,0)),c=0;c<j.length;c++)b(j[c]);return d};b._i.push([e,f,c])};b.__SV=1.2;e=f.createElement("script");e.type="text/javascript";e.async=!0;e.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";g=f.getElementsByTagName("script")[0];g.parentNode.insertBefore(e,g)}})(document,window.mixpanel||[]);
      mixpanel.init('61e3f170295a9a4135e64a3e651e53a1', {track_pageview: false, persistence: 'localStorage'});
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <!-- Skip to content link for keyboard users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--color-accent)] focus:text-white focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <MobileWalletBanner client:load />

    <header class="border-b border-[var(--color-border)] sticky top-0 z-50 bg-[var(--color-bg)]/90 backdrop-blur-md">
      <nav aria-label="Main" class="max-w-6xl mx-auto px-4 h-[52px] flex items-center justify-between">
        <a href="/" class="py-2 px-1 min-h-[44px] flex items-center gap-2">
          <img src="/logo.png" alt="" width="24" height="24" class="rounded-md" aria-hidden="true" />
          <span class="font-bold tracking-tight" style="font-size: var(--text-lg);">Hype<span class="text-[var(--color-accent)]">Fees</span></span>
        </a>
        <div class="flex items-center gap-4" id="header-actions">
          <FeeCounter client:load />
          <slot name="header-actions" />
        </div>
      </nav>
    </header>

    <main id="main" class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto px-4 py-10 text-sm text-[var(--color-text-muted)]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 mb-3">
              <img src="/logo.png" alt="" width="24" height="24" class="rounded" loading="lazy" aria-hidden="true" />
              <span class="text-base font-bold text-[var(--color-text)]">Hype<span class="text-[var(--color-accent)]">Fees</span></span>
            </div>
            <p class="text-xs leading-relaxed">
              <TranslatedText client:load k="footer.description" />
            </p>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3"><TranslatedText client:load k="footer.tools" /></div>
            <ul class="space-y-2 text-xs">
              <li><a href="#main" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]"><TranslatedText client:load k="footer.feeLookup" /></a></li>
              <li><a href="#main" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]"><TranslatedText client:load k="footer.builderComparison" /></a></li>
              <li><a href="#main" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]"><TranslatedText client:load k="footer.feeCalculator" /></a></li>
              <li><a href="#main" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]"><TranslatedText client:load k="footer.oneClickSwitch" /></a></li>
            </ul>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3"><TranslatedText client:load k="footer.resources" /></div>
            <ul class="space-y-2 text-xs">
              <li><a href="https://hyperliquid.gitbook.io/hyperliquid-docs/trading/fees" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Hyperliquid Fee Docs</a></li>
              <li><a href="https://hyperliquid.gitbook.io/hyperliquid-docs/trading/builder-codes" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Builder Codes Docs</a></li>
              <li><a href="https://app.coinmarketman.com/hypertracker/builders" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">HyperTracker</a></li>
              <li><a href="https://app.hyperliquid.xyz" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Hyperliquid App</a></li>
            </ul>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3"><TranslatedText client:load k="footer.project" /></div>
            <ul class="space-y-2 text-xs">
              <li><a href="https://github.com/rayston92/hypefees" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">GitHub</a></li>
              <li><a href="https://github.com/rayston92/hypefees/issues" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-secondary)] transition-colors py-1 inline-flex items-center min-h-[44px]">Report Issue</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-[var(--color-border)] mt-8 pt-6 text-xs text-[var(--color-text-muted)] space-y-2">
          <p>
            <TranslatedText client:load k="footer.disclaimer1" />
          </p>
          <p>
            <TranslatedText client:load k="footer.disclaimer2" />
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
