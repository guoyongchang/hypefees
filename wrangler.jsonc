{
	"account_id": "295a440e52b93ec304b578e6b4db0bf3",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "hypefees",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "hypefees.com/*", "zone_name": "hypefees.com" },
		{ "pattern": "www.hypefees.com/*", "zone_name": "hypefees.com" }
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "2986cfb2f1e541b9a2289d7794f4c993"
		}
	]
}